{
  "family": "majboor-ui-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::749210468718:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "WEB_SITE_CONTAINER",
      "image": "749210468718.dkr.ecr.ap-south-1.amazonaws.com/majboor-ui:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": []
    }
  ]
}